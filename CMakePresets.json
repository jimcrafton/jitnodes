{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "x64-debug",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "x64-asan",
      "inherits": "x64-debug",
      "cacheVariables": { "JITNODES_SANITIZE": "ON", "JITNODES_BUILD_EXAMPLES": "OFF" }
    },
    {
      "name": "x64-debug-editor",
      "inherits": "x64-debug",
      "cacheVariables": { "JITNODES_BUILD_EDITOR": "ON" }
    },
    {
      "name": "x64-release-editor",
      "inherits": "x64-release",
      "cacheVariables": { "JITNODES_BUILD_EDITOR": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" },
    { "name": "x64-asan", "configurePreset": "x64-asan" },
    { "name": "x64-debug-editor", "configurePreset": "x64-debug-editor" },
    { "name": "x64-release-editor", "configurePreset": "x64-release-editor" }
  ],
  "testPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "output": { "outputOnFailure": true } },
    { "name": "x64-release", "configurePreset": "x64-release", "output": { "outputOnFailure": true } },
    { "name": "x64-asan", "configurePreset": "x64-asan", "output": { "outputOnFailure": true } },
    { "name": "x64-debug-editor", "configurePreset": "x64-debug-editor", "output": { "outputOnFailure": true } },
    { "name": "x64-release-editor", "configurePreset": "x64-release-editor", "output": { "outputOnFailure": true } }
  ]
}
