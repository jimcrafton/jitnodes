// The same 2,500 random points before (left) and after (right) relax: the clumps and gaps give way to an even, blue-noise spacing.
//   jitnodesCli examples/graphs/fx/fxRelax.json --png fxRelax.png
// See docs/fx.md.
{
  format: "jitnodes",
  version: 1,
  fps: 24,
  display: 20,
  nodes: [
    { id: 1, type: "generate", name: "randomLeft", floats: { count: 2500, seed: 7, cx: -6, width: 10, height: 10 }, inputs: [] },
    { id: 2, type: "generate", name: "randomRight", floats: { count: 2500, seed: 7, cx: 6, width: 10, height: 10 }, inputs: [] },
    { id: 3, type: "relax", name: "relaxed", floats: { radius: 0.3, iterations: 60, strength: 0.5 }, inputs: [2] },
    { id: 4, type: "merge", name: "both", inputs: [1, 3] },
    { id: 5, type: "wrangle", name: "look", strings: { code: "radius = 0.09; alpha = 1; softness = 0; Cd.x = lerp(0.35, 0.8, rand); Cd.y = lerp(0.75, 0.95, rand); Cd.z = 1;" }, inputs: [4] },
    {
      id: 20, type: "render", name: "image",
      floats: { additive: 0, width: 700, height: 350, viewWidth: 24 },
      strings: { background: "#05060c" },
      inputs: [5]
    }
  ]
}
