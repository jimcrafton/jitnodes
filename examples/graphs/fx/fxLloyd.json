// lloyd moves every point to the centre of its voronoi cell, so repeating it evens out a random point set. Left to right: 60 random sites,
// after 2 lloyd iterations, after 30. The outlines are the voronoi cells (open, walked by scatter); the orange dots are the sites.
//   jitnodesCli examples/graphs/fx/fxLloyd.json --png fxLloyd.png
// See docs/fx.md.
{
  format: "jitnodes",
  version: 1,
  fps: 24,
  display: 40,
  nodes: [
    { id: 1, type: "generate", name: "sitesA", floats: { count: 60, seed: 5, cx: -12, width: 10, height: 10 }, inputs: [] },
    { id: 2, type: "generate", name: "sitesB", floats: { count: 60, seed: 5, cx: 0, width: 10, height: 10 }, inputs: [] },
    { id: 3, type: "lloyd", name: "twice", floats: { iterations: 2 }, inputs: [2] },
    { id: 4, type: "generate", name: "sitesC", floats: { count: 60, seed: 5, cx: 12, width: 10, height: 10 }, inputs: [] },
    { id: 5, type: "lloyd", name: "settled", floats: { iterations: 30 }, inputs: [4] },
    { id: 6, type: "merge", name: "sites", inputs: [1, 3, 5] },
    {
      id: 7, type: "wrangle", name: "siteLook",
      strings: { code: "radius = 0.16; alpha = 1; softness = 0.6; Cd.x = 1; Cd.y = 0.55; Cd.z = 0.15;" },
      inputs: [6]
    },
    { id: 8, type: "voronoi", name: "cellsA", floats: { closed: 0 }, inputs: [1] },
    { id: 9, type: "voronoi", name: "cellsB", floats: { closed: 0 }, inputs: [3] },
    { id: 10, type: "voronoi", name: "cellsC", floats: { closed: 0 }, inputs: [5] },
    { id: 11, type: "merge", name: "cells", inputs: [8, 9, 10] },
    { id: 12, type: "scatter", name: "walk", floats: { count: 0, lineCount: 40000, spread: 0.02, seed: 2 }, inputs: [11] },
    {
      id: 13, type: "wrangle", name: "outlineLook",
      strings: { code: "radius = 0.05; alpha = 0.8; softness = 1; Cd.x = 0.5; Cd.y = 0.9; Cd.z = 1;" },
      inputs: [12]
    },
    { id: 14, type: "merge", name: "all", inputs: [7, 13] },
    {
      id: 40, type: "render", name: "image",
      floats: { additive: 1, exposure: 1.0, gamma: 2.2, width: 840, height: 300, viewWidth: 36 },
      strings: { background: "#000000" },
      inputs: [14]
    }
  ]
}
