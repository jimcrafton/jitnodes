// Four strange attractors drawn from 400,000 points each: the attractor node pushes every seed point through a chaotic map, and the
// density of the points, drawn additively, shows the shape. Colour comes from the direction of the last step (dir) and its length (speed).
//   jitnodesCli examples/graphs/fx/fxAttractor.json --png fxAttractor.png
// See docs/fx.md.
{
  format: "jitnodes",
  version: 1,
  fps: 24,
  display: 40,
  nodes: [
    { id: 1, type: "generate", name: "seedsA", floats: { count: 400000, seed: 1, width: 4, height: 4 }, inputs: [] },
    { id: 2, type: "attractor", name: "clifford", floats: { a: -1.4, b: 1.6, c: 1.0, d: 0.7, iterations: 30, scale: 2.2, cx: -5.5, cy: 5.5 }, strings: { type: "clifford" }, inputs: [1] },
    { id: 3, type: "colorRamp", name: "colorA", floats: { min: 0, max: 1 }, strings: { attribute: "dir", ramp: "0 #ff5a36, 0.5 #ffd27a, 1 #fff4d8" }, inputs: [2] },
    { id: 4, type: "generate", name: "seedsB", floats: { count: 400000, seed: 2, width: 4, height: 4 }, inputs: [] },
    { id: 5, type: "attractor", name: "deJong", floats: { a: 1.641, b: 1.902, c: 0.316, d: 1.525, iterations: 30, scale: 2.4, cx: 5.5, cy: 5.5 }, strings: { type: "dejong" }, inputs: [4] },
    { id: 6, type: "colorRamp", name: "colorB", floats: { min: 0, max: 1 }, strings: { attribute: "dir", ramp: "0 #2f6bff, 0.5 #7fd4ff, 1 #f2fbff" }, inputs: [5] },
    { id: 7, type: "generate", name: "seedsC", floats: { count: 400000, seed: 3, width: 4, height: 4 }, inputs: [] },
    { id: 8, type: "attractor", name: "clifford2", floats: { a: -1.7, b: 1.3, c: -0.1, d: -1.2, iterations: 30, scale: 2.4, cx: -5.5, cy: -5.5 }, strings: { type: "clifford" }, inputs: [7] },
    { id: 9, type: "colorRamp", name: "colorC", floats: { min: 0, max: 1 }, strings: { attribute: "dir", ramp: "0 #a23cff, 0.5 #ff7ad9, 1 #ffe9f6" }, inputs: [8] },
    { id: 10, type: "generate", name: "seedsD", floats: { count: 400000, seed: 4, width: 4, height: 4 }, inputs: [] },
    { id: 11, type: "attractor", name: "svensson", floats: { a: 1.5, b: -1.8, c: 1.6, d: 0.9, iterations: 30, scale: 1.8, cx: 5.5, cy: -5.5 }, strings: { type: "svensson" }, inputs: [10] },
    { id: 12, type: "colorRamp", name: "colorD", floats: { min: 0, max: 1 }, strings: { attribute: "dir", ramp: "0 #22c08a, 0.5 #9be86a, 1 #f6ffd8" }, inputs: [11] },
    { id: 20, type: "merge", name: "all", inputs: [3, 6, 9, 12] },
    { id: 30, type: "wrangle", name: "look", strings: { code: "radius = 0.02; alpha = 0.12; softness = 1;" }, inputs: [20] },
    {
      id: 40, type: "render", name: "image",
      floats: { additive: 1, exposure: 1.3, gamma: 2.2, width: 720, height: 720, viewWidth: 24 },
      strings: { background: "#000000" },
      inputs: [30]
    }
  ]
}
