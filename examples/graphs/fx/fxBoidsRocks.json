// A flock steering round obstacles. The rocks are the points of a second input to boids: each one is a circle with the point's own radius
// attribute (set by a wrangle from rand), and the same points are merged into the picture as big soft discs. The 900 boids start on the left,
// are pulled towards a goal on the right (goal) and part round the rocks (avoid, avoidDistance); at t = 4.8 the front of the flock has split
// in two and streams through the gaps. A boid that ends up inside a rock is moved to its surface.
//   jitnodesCli examples/graphs/fx/fxBoidsRocks.json --png fxBoidsRocks.png --time 4.8
// See docs/fx.md.
{
  format: "jitnodes",
  version: 1,
  fps: 24,
  display: 20,
  nodes: [
    { id: 1, type: "generate", name: "start", floats: { count: 900, seed: 1, cx: -15, width: 8, height: 14 }, inputs: [] },
    { id: 2, type: "generate", name: "rockPoints", floats: { count: 7, seed: 4, cx: 0, width: 14, height: 11 }, inputs: [] },
    { id: 3, type: "wrangle", name: "rocks", strings: { code: "radius = 0.9 + rand * 0.9; alpha = 0.55; softness = 0.2; Cd.x = 0.55; Cd.y = 0.5; Cd.z = 0.45;" }, inputs: [2] },
    {
      id: 4, type: "boids", name: "flock",
      floats: {
        radius: 1.4, separationRadius: 0.5, separation: 1.2, alignment: 1.5, cohesion: 0.5, minSpeed: 2, maxSpeed: 4, maxForce: 8,
        goal: 1.5, goalX: 30, goalY: 0, avoid: 6, avoidDistance: 1.2, wander: 0.3,
        boundsMinX: -20, boundsMaxX: 20, boundsMinY: -9, boundsMaxY: 9, seed: 3
      },
      inputs: [1, 3]
    },
    { id: 5, type: "colorRamp", name: "headingColor", floats: { min: -1.5708, max: 1.5708 }, strings: { attribute: "angle", ramp: "0 #4aa8ff, 0.5 #e9fff4, 1 #ff9a5a" }, inputs: [4] },
    { id: 6, type: "wrangle", name: "boidLook", strings: { code: "radius = 0.1; alpha = 0.9; softness = 0.8;" }, inputs: [5] },
    { id: 7, type: "merge", name: "all", inputs: [3, 6] },
    {
      id: 20, type: "render", name: "image",
      floats: { additive: 1, exposure: 1.0, gamma: 2.2, width: 900, height: 405, viewCx: 0, viewCy: 0, viewWidth: 40 },
      strings: { background: "#000000" },
      inputs: [7]
    }
  ]
}
