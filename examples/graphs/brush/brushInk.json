// Sumi ink, an enso: one stroke of an almost closed circle. The pressure profile is the `w` attribute (a quick swell, then a long thinning),
// which ribbon uses as the width. Dots fan out across the stroke as in brushOil, but the ink is one flat black, edges are crisp, and as the
// brush runs dry the bristles drop out in streaks ("flying white").
//   jitnodesCli examples/graphs/brush/brushInk.json --png brushInk.png
// See docs/brushStrokes.md.
{
  format: "jitnodes",
  version: 1,
  fps: 24,
  display: 20,
  nodes: [
    { id: 1, type: "line", name: "guide", floats: { count: 400, length: 1 }, inputs: [] },
    {
      id: 2, type: "wrangle", name: "circle",
      strings: {
        code: "t = x; ang = 0.7 + t * 5.5; r = 4.0 + 0.35 * sin(t * 9) + 0.5 * t; x = r * cos(ang); y = r * sin(ang); p = clamp(t * 12, 0, 1); w = sqrt(p) * (1 - 0.8 * t * t) + 0.04;"
      },
      inputs: [1]
    },
    { id: 3, type: "ribbon", name: "brush", floats: { width: 1.3, widthEnd: 1.3 }, strings: { widthAttrib: "w", output: "rungs" }, inputs: [2] },
    { id: 4, type: "wrangle", name: "keepAlong", strings: { code: "along = u;" }, inputs: [3] },
    { id: 5, type: "curveSample", name: "bristles", floats: { count: 0, spacing: 0.022 }, inputs: [4] },
    {
      id: 6, type: "wrangle", name: "ink",
      strings: {
        code: "k = floor(u * 64); h = sin(k * 12.9898 + 78.233) * 43758.5453; h = h - floor(h); g = sin(x * 91.7 + y * 53.1) * 43758.5453; g = g - floor(g); dry = along * along * 1.5 - 0.1; keep = h > dry ? 1 : 0; keep = g > dry * 0.35 ? keep : 0; Cd.x = 0.05; Cd.y = 0.05; Cd.z = 0.07; radius = 0.06; softness = 0.4; alpha = keep * 0.95;"
      },
      inputs: [5]
    },
    {
      id: 20, type: "render", name: "image",
      floats: { additive: 0, exposure: 1.0, gamma: 1.0, width: 700, height: 700, viewCx: 0, viewCy: 0, viewWidth: 12.5 },
      strings: { background: "#f1ece0" },
      inputs: [6]
    }
  ]
}
