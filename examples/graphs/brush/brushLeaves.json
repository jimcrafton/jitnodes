// A brush made of vector shapes instead of dots: one leaf-shaped polygon is stamped along a curve with copyToPoints. curveSample places the
// targets and gives each its tangent; a wrangle turns the tangent into a rotation (an atan2 built from a polynomial, because the language has none),
// scales the leaf by the pressure w, and shakes position, angle and size with a hash. The render node's `fill` makes the renderer fill the closed
// polygons (colour and alpha of each shape's first point) with anti-aliased edges, so the shapes stay sharp at any image size, unlike dots.
//   jitnodesCli examples/graphs/brush/brushLeaves.json --png brushLeaves.png
// See docs/brushStrokes.md.
{
  format: "jitnodes",
  version: 1,
  fps: 24,
  display: 20,
  nodes: [
    { id: 1, type: "line", name: "guide", floats: { count: 300, length: 14 }, inputs: [] },
    {
      id: 2, type: "wrangle", name: "bend",
      strings: { code: "t = x / 14; x = x - 7; y = 1.7 * sin(t * 5.2) + 0.35 * sin(t * 13 + 1) - 0.4; s = sin(t * 3.14159); w = 0.3 + 0.7 * sqrt(s);" },
      inputs: [1]
    },
    { id: 3, type: "curveSample", name: "stamps", floats: { count: 220, spacing: 0 }, inputs: [2] },
    {
      id: 4, type: "wrangle", name: "orient",
      strings: {
        code: "ax = abs(tx); ay = abs(ty); lo = min(ax, ay); hi = max(ax, ay); z = lo / (hi + 0.000001); q = z * (0.7853982 + 0.273 * (1 - z)); q = ay > ax ? 1.5707963 - q : q; q = tx < 0 ? 3.1415927 - q : q; q = ty < 0 ? 0 - q : q; h = sin(x * 57.3 + y * 131.7) * 43758.5453; h = h - floor(h); g = sin(x * 12.9 + y * 78.2) * 24634.6345; g = g - floor(g); k = sin(x * 39.3 + y * 11.1) * 31415.9265; k = k - floor(k); across = (h - 0.5) * 1.6 * w; x = x + nx * across; y = y + ny * across; angle = q + (g - 0.5) * 1.3; scale = w * (0.55 + 0.7 * k);"
      },
      inputs: [3]
    },
    { id: 5, type: "circle", name: "blank", floats: { count: 14, radius: 1 }, inputs: [] },
    { id: 6, type: "wrangle", name: "leaf", strings: { code: "x = x * 1.5; y = y * 0.5 * (1 - 0.55 * abs(x) / 1.5);" }, inputs: [5] },
    { id: 7, type: "copyToPoints", name: "stamp", floats: { scale: 0.6, angle: 0 }, inputs: [6, 4] },
    {
      id: 8, type: "wrangle", name: "paint",
      strings: {
        code: "m = copyIndex / 220; h = sin(copyIndex * 12.9898 + 78.233) * 43758.5453; h = h - floor(h); t = clamp(m + (h - 0.5) * 0.35, 0, 1); Cd.x = lerp(0.1, 0.95, t); Cd.y = lerp(0.45, 0.62, t * t) + 0.12 * h; Cd.z = lerp(0.5, 0.18, t); alpha = 0.78;"
      },
      inputs: [7]
    },
    {
      id: 20, type: "render", name: "image",
      floats: { additive: 0, fill: 1, exposure: 1.0, gamma: 1.0, width: 900, height: 600, viewCx: 0, viewCy: -0.4, viewWidth: 17 },
      strings: { background: "#f3ecdc" },
      inputs: [8]
    }
  ]
}
